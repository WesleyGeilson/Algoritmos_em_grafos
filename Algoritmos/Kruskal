Algoritmo_Kruskal_MOD(G, F, P) {
    Para cada vértice i em G {   
        pai[i] = i
        rank[i] = 0
    }
    // 1. Processa as arestas FORÇADAS primeiro
    A = {}
    Para cada aresta (u, v) em F {
        chefe_u = Representante(u)
        chefe_v = Representante(v)
        Se (chefe_u == chefe_v) {
            Retorna "Não existe árvore geradora (ciclo nas arestas forçadas)"
        } 
        Senão {
            União(u, v)
            Adiciona aresta (u, v) em A

        }
    }
    // 2. Prepara as arestas restantes
    Seja 'LA' todas as arestas de G
    Ordena(LA) em ordem crescente de peso // O(m log m) - O termo que domina!
    Transforme P e F em Tabelas Hash para buscas em O(1)
    // 3. Processa o restante, ignorando F (já inserido) e P (proibidas)
    Para cada aresta (u, v) em LA {
        // Pulo do gato em O(1): se é proibida ou já foi forçada, simplesmente ignore!
        Se ((u,v) está em P) OU ((u,v) está em F) {
            Continue
        }
        chefe_u = Representante(u)
        chefe_v = Representante(v)

        Se (chefe_u != chefe_v) {
            União(u, v)
            Adiciona aresta (u, v) em A
        }
    }
