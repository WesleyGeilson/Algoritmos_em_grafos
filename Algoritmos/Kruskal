Algoritmo_Kruskal(G) {
    Para cada vértice i em G{
        pai[i] = i
        rank[i] = 0          
    }
    
    Seja 'LA' todas as arestas de G
    Ordena(LA) em ordem crescente de peso
    
    // Conjunto que guardará as ruas que farão parte da resposta final
    A = {}
    Para cada aresta (u, v) em LA{
        
        // Verifica quem é o "chefe" do grupo de 'u' e do grupo de 'v'
        chefe_u = Representante(u) // No pior caso a complexidade é? 
        chefe_v = Representante(v)
        
        // Se eles têm chefes diferentes, significa que não estão no mesmo grupo ainda!
        Se (chefe_u != chefe_v) {
            União(u, v)
            Adiciona aresta (u, v) A // A U {(u, v)}
        }
    } 
    Retorna A
}

Representante(u) {
    Se (pai[u] == u) {
        Retorna u
    } Senão {
        pai[u] = Representante(pai[u])  // achata o caminho
        Retorna pai[u]
    }
}

// anexação de arvores inteligente (union by rank)
União(u, v) {
    chefe_u = Representante(u)
    chefe_v = Representante(v)
    Se (chefe_u == chefe_v){
        Retorna
    }
    Se (rank[chefe_u] < rank[chefe_v]) {
        pai[chefe_u] = chefe_v
    } Senão Se (rank[chefe_u] > rank[chefe_v]) {
        pai[chefe_v] = chefe_u
    } Senão {
        pai[chefe_v] = chefe_u
        rank[chefe_u]++
    }
}


