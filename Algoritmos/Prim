Algoritmo Prim(G, v_inicial) {

    Para cada vértice u no G{
        prioridade[u] = INFINITO   // o(n)
        pai[u] = NULO              
    }
    
    prioridade[v_inicial] = 0      
    
    H = Construir_Fila_Prioridade(G.Vértices, prioridade) // O(n)
    Enquanto (H não estiver vazio){
        v = Remove_Minimo(H) // O(log n)
    
        Para cada vizinho w de v contido no H{ //O(m)
            peso_aresta = Peso(v, w)
            Se (peso_aresta < prioridade[w]) {
                prioridade[w] = peso_aresta   // Atualiza com o novo preço baixo
                pai[w] = v                    // Anota que 'v' é quem fornece essa conexão
                Atualizar_Valor(H, prioridade[w]) // Reorganiza a fila O(log n)
            }
        }
    }
    
    Retorna pai // Retorna a estrutura da Árvore (quem está conectado a quem)
}

