// 2. (15 pontos) Modifique o Algoritmo de Kruskal para determinar uma árvore geradora mínima, se alguma existe,
// de um grafo simples conexo ponderado G = (V, E) com função de pesos w : E(G) > R, onde um conjunto F de
// arestas são forçadas a estarem na árvore e outro conjunto P de arestas são proibidas de pertencerem a árvore.
// Considere que |F| = f e |P| = p, onde F e P são dados como entrada em forma de vetores. A complexidade do seu
// algoritmo não pode ser superior a do Algoritmo de Kruskal original. Justifique.

// R= 
Algoritmo_Kruskal_MOD(G, F, P) { // G, grafo ; F, vetor de arestas forçadas, P, vetor de arestas forçadas. complexidade : o(m log m)
    Para cada vértice i em G {   
        pai[i] = i
        rank[i] = 0
    }
    //Processa as arestas FORÇADAS primeiro
    A = {}
    Para cada aresta (u, v) em F {
        chefe_u = Representante(u)
        chefe_v = Representante(v)
        Se (chefe_u == chefe_v) {
            Retorna "Não existe árvore geradora (ciclo nas arestas forçadas)"
        } 
        Senão {
            União(u, v)
            Adiciona aresta (u, v) em A

        }
    }
    //Prepara as arestas restantes
    Seja 'LA' todas as arestas de G
    Ordena(LA) em ordem crescente de peso // O(m log m) - O termo que domina!
    Transforma P e F em Tabelas Hash para buscas em O(1)
    //Processa o restante, ignorando F (já inserido) e P (proibidas)
    Para cada aresta (u, v) em LA {
        //se é proibida ou já foi forçada, simplesmente ignore
        Se ((u,v) está em P) OU ((u,v) está em F) {
            Continue
        }
        chefe_u = Representante(u)
        chefe_v = Representante(v)

        Se (chefe_u != chefe_v) {
            União(u, v)
            Adiciona aresta (u, v) em A
        }
    }
    //Verificação final de conectividade
    Se (Tamanho(A) != n - 1) {
        Retorna "Não existe árvore geradora (grafo desconexo)"
    }
    Retorna A
}

