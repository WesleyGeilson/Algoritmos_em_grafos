// é uma floresta ou não sem utilizar percursos em grafos. Justifique.
// R= 

IsFlorest(G,n){ // seja n o numero de vertices previo
    contagem_de_aresta = 0
    Para cada vertice u em G{ // criei uma solução alternativa pois acredito que a complexidade aqui ultrapasse o O(n) 
        Para cada vizinho w em u{
            contagem_de_aresta++    
            // temos uma aresta "indo" e "voltando" na vez de u e na vez de v, respectivamente
        } 
        contagem_de_aresta++ 
        Se(contagem_de_aresta >= 2*n ){
            retorna "ciclo, pois existem mais arestas do que vertices, deve haver ciclos!"
        }
    }
    Para cada vértice i em G {   
        pai[i] = i
        rank[i] = 0
    }
    Para cada vertice u em G{
        Para cada vizinho w em u{
            Se (u < w)
            chefe_u = Representante(u)
            chefe_w = Representante(w)
            Se (chefe_u == chefe_w) {
                Retorna "Não é uma floresta, pois existe ciclo"
            } 
            Senão {
                União(u, w)
            }
        }    
    }
    retorna "Passou em todos os testes, é uma floresta, pois não existem ciclos"
}

